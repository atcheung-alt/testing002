prisma/dev.db
prisma/dev.db-journal
*.db
*.db-journal

# Vercel
.vercel

# TypeScript / build artifacts
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

