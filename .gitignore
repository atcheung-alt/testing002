# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables — NEVER commit these (contains AUTH_SECRET, Google
# OAuth secret, database credentials). Only .env.example should be tracked.
.env
.env*.local
.env.production
.env.development

